{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 18 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "vs2026", "configuration": "Release"},
    {"name": "debug", "configurePreset": "vs2026", "configuration": "Debug"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "vs2026", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "vs2026", "configuration": "Debug", "output": {"outputOnFailure": true}}
  ]
}
